@using Streamingservice
@using Streamingservice.Contents

@model List<Content>
@{
    ViewBag.Title = "title";
    Layout = "_Layout";

}

<style>
    .list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .list a {
        text-decoration: none;
        color: #333333;
        font-weight: 600;
        display: inline-block;
        transition: transform 0.1s, color 0.1s;
        margin-bottom: .2em;
    }
    
    .list a:hover {
        color: #ffc107;
        transform: translateX(.1em);
    }
</style>

<h2>@ViewBag.Label@(Model.FirstOrDefault() is Movie ? "s" : "")</h2>
<body>
    <ul class="list">
        @foreach (Content content in @Model)
        {
            <li>
                <a asp-controller="ContentSelection" asp-action="SelectContent" asp-route-selectedContentId="@content.Id">
                    @content.Title
                    @(content.IsExclusive == true ? "☆" : "")
                </a>
            </li>
        }
    </ul>
</body>