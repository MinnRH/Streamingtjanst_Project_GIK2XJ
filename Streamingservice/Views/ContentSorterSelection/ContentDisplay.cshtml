@using Streamingservice
@using Streamingservice.Contents

@model List<Content>
@{
    ViewBag.Title = "title";
    Layout = "_Layout";

}

<h2>@ViewBag.Label</h2>
<body>
    <ul>
        @foreach (Content content in @Model)
        {
            <li>
            <a asp-controller="ContentSelection" asp-action="SelectContent" asp-route-selectedContentId="@content.Id">@content.Title</a>
            </li>
        }
    </ul>
</body>